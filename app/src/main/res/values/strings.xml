    <string name="section_preset">预设</string>

    <string name="feature_count_title">自定义剪贴板条数</string>
    <string name="feature_count_summary">原版「最近」一栏只留 5 条，超出的直接看不到</string>
    <string name="feature_ttl_title">自定义剪贴板有效期</string>
    <string name="feature_ttl_summary">原版复制满 1 小时就从面板消失</string>
    <string name="feature_chars_title">自定义剪贴板字数上限</string>
    <string name="feature_chars_summary">原版单条超过 20000 字会被截断后再存</string>
    <string name="feature_slide_up_title">自定义按键上滑</string>
